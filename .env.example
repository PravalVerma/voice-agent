# Copy this file to .env and fill in the values for the providers you use.

# Required for stt.provider = "groq" and/or llm.provider = "groq" (the defaults)
GROQ_API_KEY=

# Only needed if you set tts.provider = "google" in config.toml. The default
# provider ("edge") needs no key at all, so leave this empty unless you switch.
# Path to a Google Cloud service-account JSON with the Text-to-Speech API enabled.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional — only needed if you switch providers in config.toml
OPENAI_API_KEY=
# Required for any bot whose Advanced Settings > Bots pipeline is "Gemini"
# (all of STT/LLM/TTS run on Gemini for that bot's calls) or "Gemini Live"
# (a single continuous Gemini Live API audio session instead) - get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeds the first admin login on startup, only if data/app.db has no users yet.
# After that, manage accounts from the Users page instead of these.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to true only if this is ever served over HTTPS - it makes the session
# cookie Secure-only. Leave false for the local http setup.
COOKIE_SECURE=false

# Call recordings (config.toml -> [call] record_calls) are always written to the
# call's log dir. Set S3_RECORDINGS_BUCKET to also archive each one to S3;
# leave it empty and recordings simply stay on local disk.
#
# On EC2 the attached instance role is used automatically - no access key or
# secret needed, and the region comes from instance metadata. Only set
# AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY when running somewhere
# without a role (e.g. local development).
S3_RECORDINGS_BUCKET=
S3_RECORDINGS_PREFIX=arcil

